# ToolJet - Low-code application builder
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname / Domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# App secrets (generate with: openssl rand -hex 32)
APP_SECRET_KEY=changeme_secret_key_min_32_chars
LOCKBOX_MASTER_KEY=changeme_lockbox_master_key_32c

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=tooljet
DB_USER_NAME=tooljet
DB_USER_PASS=changeme_db_password
